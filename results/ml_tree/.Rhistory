~Type,               ~id_code,  ~color,
"fabric",            "fab1",    "black",
"fabric",            "fab2",    "dark grey",
"fabric",            "fab3",    "light grey",
"fabric",            "fab4",    "dark grey",
"fabric",            "fab5",    "gray",
"fabric",            "fab6",    "light gray",
"paper",             "pap1",    "black",
"paper",             "pap2",    "silver fox",
"paper",             "pap3",    "grey kraft",
"paper",             "pap4",    "solar white",
"paper",             "pap5",    "white",
"paper",             "pap6",    "green",
"paper",             "pap7",    "white",
"paper",             "pap8",    "silver fox",
"paper",             "pap9",    "dark gray",
"herbarium sheet",   "pap10",   "yellow",
"herbarium sheet",   "pap11",   "white",
"herbarium sheet",   "pap12",   "white",
"herbarium sheet",   "pap13",   "white",
"herbarium sheet",   "pap14",   "white",
"felt",              "fel1",    "silver grey",
"felt",              "fel2",    "bluish gray",
"felt",              "fel3",    "gray",
"felt",              "fel4",    "black",
"foam",              "foa1",    "gray",
"foam",              "foa2",    "black",
"Spraypaint",        "spr1",    "black",
"Spraypaint",        "spr2",    "dark gray",
"Spraypaint",        "spr3",    "gray",
"Spraypaint",        "spr4",    "light gray",
"paint",             "panel2",  "dark gray",
"paint",             "panel3",  "gray",
"paint",             "panel4",  "light gray",
"paint",             "panel5",  "very light gray"
)
type_order <- c(
"fabric",
"felt",
"foam",
"paper",
"herbarium sheet",
"paint",
"Spraypaint"
)
photo_lookup <- tribble(
~Type,              ~photo_file,
"fabric",           "fabric.jpeg",
"felt",             "felt.jpeg",
"foam",             "foam.jpeg",
"paper",            "papers.jpeg",
"herbarium sheet",  "herbarium_papers.jpeg",
"paint",            "paint-panels.jpeg",
"Spraypaint",       "spraypaints.jpeg"
) %>%
mutate(
photo_path = file.path(photo_dir, photo_file),
lowres_path = file.path(photo_lowres_dir, photo_file)
)
all_sed_files <- list.files(
sed_dir,
pattern = "\\.sed$",
full.names = TRUE
)
# Exclude calibration / reference / endpoint files that are not in metadata.
# This keeps files like -spr1_00030.sed but excludes .spr1_00009.sed.
sed_files <- all_sed_files[
!str_detect(
basename(all_sed_files),
"tcb|tcw|tcmusouB|End|\\.tcw_|\\.spr1_"
)
]
cat("Total .sed files in directory:", length(all_sed_files), "\n")
cat("Retained .sed files:", length(sed_files), "\n")
cat("Dropped .sed files:", length(setdiff(all_sed_files, sed_files)), "\n\n")
cat("Dropped files:\n")
print(basename(setdiff(all_sed_files, sed_files)))
spec <- read_spectra(
path = sed_files,
format = "sed",
type = "target_reflectance",
extract_metadata = FALSE
)
if (is.list(spec) && !inherits(spec, "spectra")) {
stop(
"read_spectra() returned a list, likely because files have incompatible wavelength grids."
)
}
spec_df <- as.data.frame(spec, fix_names = "none", metadata = FALSE)
names(spec_df)[1] <- "sample_name"
spectra_long <- spec_df %>%
pivot_longer(
cols = -sample_name,
names_to = "wavelength",
values_to = "reflectance"
) %>%
mutate(
wavelength = as.numeric(wavelength),
file = basename(sample_name),
# Handles both:
# NaturaSpec_SN24594C1-fab1_00113.sed
# NaturaSpec_SN24594C1.spr1_00009.sed
id_code = str_match(file, "SN24594C1[-\\.](.+?)_\\d+\\.sed$")[, 2],
measurement_id = str_match(file, "_(\\d+)\\.sed$")[, 2]
) %>%
left_join(sample_info, by = "id_code") %>%
dplyr::filter(!is.na(Type)) %>%
mutate(
Type = factor(Type, levels = type_order),
id_code = factor(id_code, levels = sample_info$id_code)
)
cat("\nFiles retained after joining to metadata:", n_distinct(spectra_long$file), "\n")
cat("\nid_codes found:\n")
print(sort(unique(as.character(spectra_long$id_code))))
# Check files that were read but did not match metadata
unmatched_files <- spec_df %>%
distinct(sample_name) %>%
mutate(
file = basename(sample_name),
id_code = str_match(file, "SN24594C1[-\\.](.+?)_\\d+\\.sed$")[, 2]
) %>%
anti_join(sample_info, by = "id_code")
if (nrow(unmatched_files) > 0) {
cat("\nFiles read but not matched to metadata:\n")
print(unmatched_files)
}
spectra_mean <- spectra_long %>%
group_by(Type, id_code, color, wavelength) %>%
summarize(
mean_reflectance = mean(reflectance, na.rm = TRUE),
sd_reflectance = sd(reflectance, na.rm = TRUE),
n_measurements = n_distinct(file),
.groups = "drop"
)
if (use_magick) {
cat("\nUsing magick to make low-resolution JPEG copies.\n")
for (i in seq_len(nrow(photo_lookup))) {
original <- photo_lookup$photo_path[i]
lowres <- photo_lookup$lowres_path[i]
if (file.exists(original)) {
magick::image_read(original) %>%
magick::image_resize("800x") %>%
magick::image_write(
path = lowres,
format = "jpeg",
quality = 45
)
} else {
warning("Missing photo: ", original)
}
} else {
cat("\nmagick is not installed. Using original photos instead.\n")
cat("Install magick to reduce PDF size: install.packages('magick')\n")
photo_lookup <- photo_lookup %>%
mutate(lowres_path = photo_path)
}
cat("\nPhoto sizes used in PDF, MB:\n")
print(
photo_lookup %>%
mutate(size_mb = ifelse(file.exists(lowres_path),
file.info(lowres_path)$size / 1024^2,
NA_real_)) %>%
select(Type, lowres_path, size_mb)
)
plot_photo_page <- function(type_name) {
photo_path <- photo_lookup %>%
dplyr::filter(Type == type_name) %>%
pull(lowres_path)
if (length(photo_path) == 0 || !file.exists(photo_path)) {
grid::grid.newpage()
grid::grid.text(
label = paste("No photo found for:", type_name),
x = 0.5,
y = 0.5,
gp = grid::gpar(fontsize = 18, fontface = "bold")
)
return(invisible(NULL))
}
img <- jpeg::readJPEG(photo_path)
grid::grid.newpage()
grid::grid.text(
label = paste("Material photo:", type_name),
x = 0.5,
y = 0.96,
gp = grid::gpar(fontsize = 18, fontface = "bold")
)
grid::grid.raster(
img,
x = 0.5,
y = 0.48,
width = unit(0.90, "npc"),
height = unit(0.82, "npc"),
just = "center",
interpolate = TRUE
)
invisible(NULL)
}
plot_individual_by_type <- function(type_name) {
dat <- spectra_long %>%
dplyr::filter(as.character(Type) == type_name)
ggplot(
dat,
aes(
x = wavelength,
y = reflectance,
group = file,
color = id_code
)
) +
geom_line(alpha = 0.45, linewidth = 0.35) +
facet_wrap(~ id_code, scales = "free_y") +
labs(
title = paste("Individual spectra:", type_name),
subtitle = "Each line is one .sed file / measurement",
x = "Wavelength (nm)",
y = "Reflectance",
color = "id_code"
) +
theme_bw() +
theme(
legend.position = "bottom",
strip.background = element_rect(fill = "grey90", color = NA),
panel.grid.minor = element_blank()
)
}
plot_mean_by_type <- function(type_name) {
dat <- spectra_mean %>%
dplyr::filter(as.character(Type) == type_name)
ggplot(
dat,
aes(
x = wavelength,
y = mean_reflectance,
color = id_code
)
) +
geom_line(linewidth = 0.75) +
labs(
title = paste("Mean spectra by id_code:", type_name),
subtitle = "Mean reflectance averaged across measurements within each id_code",
x = "Wavelength (nm)",
y = "Mean reflectance",
color = "id_code"
) +
theme_bw() +
theme(
legend.position = "bottom",
panel.grid.minor = element_blank()
)
}
types <- spectra_long %>%
distinct(Type) %>%
arrange(Type) %>%
pull(Type) %>%
as.character()
combined_pdf <- file.path(
out_dir,
"ALL_TYPES_material_photos_and_spectra_LOWRES.pdf"
)
pdf(
file = combined_pdf,
width = 12,
height = 8,
useDingbats = FALSE,
onefile = TRUE
)
for (tt in types) {
plot_photo_page(tt)
print(plot_individual_by_type(tt))
print(plot_mean_by_type(tt))
}
# ---- paths ----
photo_lowres_dir <- file.path(out_dir, "materials_photos_lowres")
# ---- map Type names to LOW-RES photo filenames ----
photo_lookup <- tribble(
~Type,              ~photo_file,
"fabric",           "fabric.jpeg",
"foam",             "foam.jpeg",
"paint",            "paint-panels.jpeg",
"Spraypaint",       "spraypaints.jpeg",
"felt",             "felt.jpeg",
"paper",            "papers.jpeg",
"herbarium sheet",  "herbarium_papers.jpeg"
) %>%
mutate(photo_path = file.path(photo_lowres_dir, photo_file))
# ---- optional: define preferred plotting order ----
type_order <- c(
"fabric",
"felt",
"foam",
"paper",
"herbarium sheet",
"paint",
"Spraypaint"
)
spectra_long <- spectra_long %>%
mutate(Type = factor(Type, levels = type_order))
spectra_mean <- spectra_mean %>%
mutate(Type = factor(Type, levels = type_order))
types <- spectra_long %>%
distinct(Type) %>%
arrange(Type) %>%
pull(Type) %>%
as.character()
# ---- photo page function using LOW-RES images ----
plot_photo_page <- function(type_name) {
photo_path <- photo_lookup %>%
dplyr::filter(Type == type_name) %>%
pull(photo_path)
if (length(photo_path) == 0 || !file.exists(photo_path)) {
return(NULL)
}
img <- jpeg::readJPEG(photo_path)
raster <- grid::rasterGrob(
img,
interpolate = TRUE,
width = unit(0.95, "npc"),
height = unit(0.85, "npc")
)
grid::grid.newpage()
grid::grid.text(
label = paste("Material photo:", type_name),
x = 0.5,
y = 0.96,
gp = grid::gpar(fontsize = 18, fontface = "bold")
)
grid::grid.draw(raster)
}
# ---- create one single combined PDF ----
combined_pdf <- file.path(
out_dir,
"ALL_TYPES_material_photos_and_spectra_LOWRES_IMAGES.pdf"
)
pdf(combined_pdf, width = 12, height = 8)
for (tt in types) {
plot_photo_page(tt)
print(plot_individual_by_type(tt))
print(plot_mean_by_type(tt))
}
dev.off()
message("Combined PDF written to: ", combined_pdf)
message("Combined PDF size, MB:")
print(file.info(combined_pdf)$size / 1024^2)
source("~/.active-rstudio-document", echo = TRUE)
